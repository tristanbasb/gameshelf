# ---------------------------------------------------------------------------
# GameShelf - configuration
# Copiez ce fichier vers .env si vous voulez changer quelque chose.
# Les valeurs par defaut conviennent a une installation locale.
# ---------------------------------------------------------------------------

# Port d'ecoute HTTP(S)
PORT=3000

# Interface d'ecoute. 0.0.0.0 rend l'application accessible depuis le
# telephone et les autres machines du reseau local.
HOST=0.0.0.0

# Dossier de donnees : base SQLite, images et certificat local.
DATA_DIR=./data

# HTTPS local avec un certificat auto-signe (genere au premier demarrage).
# Indispensable pour scanner un code-barres depuis un telephone : les
# navigateurs refusent la camera sur une origine non securisee.
# Mettez 0 pour servir en HTTP simple (le scan basculera en saisie manuelle).
ENABLE_HTTPS=1

# Cle API RAWG (https://rawg.io/apidocs) - optionnelle.
# Si renseignee, un bouton "En ligne" permet de pre-remplir automatiquement
# une fiche de jeu (visuel, annee, developpeur, editeur, tags...).
RAWG_API_KEY=

# Taille maximale d'une image televersee, en Mo.
MAX_UPLOAD_MB=5
