# ---------------------------------------------------------------------------
# GameShelf - configuration
# Copiez ce fichier vers .env puis adaptez les valeurs.
# ---------------------------------------------------------------------------

# Port d'ecoute HTTP
PORT=3000

# Interface d'ecoute. 127.0.0.1 si vous mettez un reverse proxy nginx devant
# (recommande), 0.0.0.0 pour exposer directement le conteneur / le service.
HOST=0.0.0.0

# Dossier de donnees : base SQLite + jaquettes uploadees.
DATA_DIR=./data

# Compte administrateur cree au tout premier demarrage.
# Si ADMIN_PASSWORD est vide, un mot de passe aleatoire est genere et affiche
# une seule fois dans les logs de demarrage.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Secret utilise pour signer les cookies de session.
# OBLIGATOIRE en production : openssl rand -hex 32
SESSION_SECRET=

# Duree de validite d'une session, en jours.
SESSION_DAYS=30

# Mettre a 1 si l'application est servie derriere un reverse proxy HTTPS
# (nginx, Traefik, Caddy...). Active le cookie Secure et le X-Forwarded-For.
TRUST_PROXY=0

# Mettre a 1 pour desactiver completement l'authentification
# (uniquement si l'app tourne sur un reseau prive de confiance).
DISABLE_AUTH=0

# Cle API RAWG (https://rawg.io/apidocs) - optionnelle.
# Si renseignee, un bouton "En ligne" permet de pre-remplir automatiquement
# une fiche de jeu (jaquette, annee, developpeur, editeur, tags...).
RAWG_API_KEY=

# Taille maximale d'une jaquette uploadee, en Mo.
MAX_UPLOAD_MB=5
